#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <math.h>
#include <Decimal_to_Binaire.h>


// Décimal -> Binaire

char *dectobin_v1(unsigned int val) {
    char *bin = malloc(33); // 32 bits + '\0'
    if (!bin) return NULL;
    int started = 0;
    int index = 0;

    for (int i = 31; i >= 0; i--) {
        unsigned int power = 1u << i; // 2^i avec un shift binaire

        if (val >= power) {
            started = 1;
            bin[index++] = '1';
            val -= power;
        } else if (started) {
            bin[index++] = '0';
        }
    }

    if (index == 0) {
        bin[index++] = '0';
    }

    bin[index] = '\0';
    return bin;
}
